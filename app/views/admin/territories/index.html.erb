<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="md:flex md:items-center md:justify-between">
        <div class="flex-1 min-w-0">
          <h1 class="text-3xl font-bold text-gray-900">
            Territory Management
          </h1>
          <p class="mt-2 text-sm text-gray-600">
            Manage territories, percentages, and media exceptions
          </p>
        </div>
        <div class="mt-4 flex gap-3 md:mt-0 md:ml-4">
          <%= link_to new_admin_territory_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Territory
          <% end %>
          <%= link_to new_admin_territory_exception_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add Exception
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Tab Navigation -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="border-b border-gray-200">
        <nav class="flex -mb-px">
          <button onclick="switchTab('territories')" id="tab-territories" class="tab-button active group inline-flex items-center px-6 py-4 border-b-2 font-medium text-sm">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Territories
            <span class="ml-2 bg-gray-100 text-gray-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= @grouped_territories.values.flatten.count %></span>
          </button>
          <button onclick="switchTab('exceptions')" id="tab-exceptions" class="tab-button group inline-flex items-center px-6 py-4 border-b-2 font-medium text-sm">
            <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            Media Exceptions
            <span class="ml-2 bg-gray-100 text-gray-900 py-0.5 px-2.5 rounded-full text-xs font-medium"><%= TerritoryMediaException.count %></span>
          </button>
        </nav>
      </div>

      <!-- Territories Tab Content -->
      <div id="content-territories" class="tab-content">
        <!-- Search Bar -->
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="max-w-md">
            <input type="text"
                   id="territory-search"
                   placeholder="Search territories..."
                   class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                   onkeyup="filterTerritories()">
          </div>
        </div>

        <%= form_with url: bulk_update_admin_territories_path, method: :patch, local: true do |f| %>
          <div class="divide-y divide-gray-200">
            <% if @grouped_territories.any? %>
              <% @grouped_territories.each do |group_name, territories| %>
                <div class="territory-group">
                  <!-- Group Header (Collapsible) -->
                  <div class="px-6 py-4 bg-gray-50 cursor-pointer hover:bg-gray-100 transition-colors" onclick="toggleGroup(this)">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-3">
                        <svg class="h-5 w-5 text-gray-400 transform transition-transform group-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                        <h3 class="text-sm font-semibold text-gray-900">
                          <%= group_name || "Individual Territories" %>
                        </h3>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          <%= territories.count %> <%= territories.count == 1 ? 'territory' : 'territories' %>
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Group Content -->
                  <div class="group-content hidden">
                    <% territories.each do |territory| %>
                      <div class="territory-item px-6 py-4 flex items-center justify-between hover:bg-blue-50 transition-colors duration-150 border-b border-gray-100 last:border-b-0 cursor-pointer"
                           data-name="<%= territory.name.downcase %>"
                           data-code="<%= territory.code&.downcase %>">
                        <div class="flex-1 flex items-center space-x-4">
                          <!-- Territory Info -->
                          <div class="min-w-0 flex-1">
                            <h4 class="text-sm font-medium text-gray-900">
                              <%= territory.name %>
                            </h4>
                            <div class="flex items-center space-x-2 text-xs text-gray-500 mt-1">
                              <% if territory.code.present? %>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                  <%= territory.code %>
                                </span>
                              <% end %>
                              <% if territory.media_type.present? %>
                                <span>•</span>
                                <span><%= territory.media_type.humanize %></span>
                              <% end %>
                            </div>
                          </div>

                          <!-- Percentage Input -->
                          <div class="flex items-center space-x-2">
                            <%= number_field_tag "territories[#{territory.id}]", territory.percentage,
                                class: "w-24 px-3 py-2 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                                step: 5, min: 0, max: 1000 %>
                            <span class="text-sm text-gray-600 font-medium">%</span>
                          </div>
                        </div>

                        <!-- Actions -->
                        <div class="ml-4 flex items-center space-x-2">
                          <%= link_to edit_admin_territory_path(territory),
                              class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                          <% end %>

                          <%= button_to admin_territory_path(territory), method: :delete,
                              data: {
                                confirm: "Are you sure you want to delete '#{territory.name}'? This cannot be undone.",
                                turbo_method: :delete
                              },
                              class: "inline-flex items-center px-3 py-1.5 border border-red-300 text-xs font-medium rounded text-red-700 bg-red-50 hover:bg-red-100 transition-colors" do %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- No Results Message -->
              <div id="no-results" class="hidden px-6 py-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No territories found</h3>
                <p class="mt-1 text-sm text-gray-500">Try adjusting your search terms.</p>
              </div>
            <% else %>
              <!-- Empty State -->
              <div class="px-6 py-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No territories found</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by creating your first territory.</p>
                <div class="mt-6">
                  <%= link_to new_admin_territory_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Create First Territory
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Update Button -->
          <% if @grouped_territories.any? %>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200">
              <div class="flex justify-end">
                <%= f.submit "Update All Percentages", class: "inline-flex justify-center items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-sm" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Exceptions Tab Content -->
      <div id="content-exceptions" class="tab-content hidden">
        <!-- Search Bar for Exceptions -->
        <div class="p-6 border-b border-gray-200 bg-gray-50">
          <div class="max-w-md">
            <input type="text"
                   id="exception-search"
                   placeholder="Search exceptions..."
                   class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg bg-white text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                   onkeyup="filterExceptions()">
          </div>
        </div>

        <div class="divide-y divide-gray-200">
          <% exceptions = TerritoryMediaException.all.order(:territory_name, :media_type) %>
          <% if exceptions.any? %>
            <% exceptions.each do |exception| %>
              <div class="exception-item px-6 py-4 flex items-center justify-between hover:bg-yellow-50 transition-colors duration-150 cursor-pointer"
                   data-territory="<%= exception.territory_name.downcase %>"
                   data-media="<%= exception.media_type_label.downcase %>">
                <div class="flex-1">
                  <div class="flex items-center space-x-4">
                    <div class="min-w-0 flex-1">
                      <h4 class="text-sm font-medium text-gray-900">
                        <%= exception.territory_name %> + <%= exception.media_type_label %>
                      </h4>
                      <% if exception.description.present? %>
                        <p class="text-sm text-gray-500 mt-1">
                          <%= exception.description %>
                        </p>
                      <% end %>
                    </div>

                    <div class="flex items-center space-x-2">
                      <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-yellow-100 text-yellow-800">
                        <%= exception.formatted_percentage %>
                      </span>
                    </div>
                  </div>
                </div>

                <div class="ml-4 flex items-center space-x-2">
                  <%= link_to edit_admin_territory_exception_path(exception),
                      class: "inline-flex items-center px-3 py-1.5 border border-gray-300 text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 transition-colors" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  <% end %>

                  <%= button_to admin_territory_exception_path(exception), method: :delete,
                      data: {
                        confirm: "Are you sure you want to delete this exception? This cannot be undone.",
                        turbo_method: :delete
                      },
                      class: "inline-flex items-center px-3 py-1.5 border border-red-300 text-xs font-medium rounded text-red-700 bg-red-50 hover:bg-red-100 transition-colors" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- No Results Message -->
            <div id="no-exception-results" class="hidden px-6 py-12 text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">No exceptions found</h3>
              <p class="mt-1 text-sm text-gray-500">Try adjusting your search terms.</p>
            </div>
          <% else %>
            <!-- Empty State -->
            <div class="px-6 py-12 text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">No exceptions configured</h3>
              <p class="mt-1 text-sm text-gray-500">Create exceptions to override standard formula calculations.</p>
              <div class="mt-6">
                <%= link_to new_admin_territory_exception_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                  Create First Exception
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tab-button {
    border-bottom-color: transparent;
    color: #6b7280;
    transition: all 0.2s;
  }

  .tab-button:hover {
    color: #374151;
    border-bottom-color: #d1d5db;
  }

  .tab-button.active {
    color: #4f46e5;
    border-bottom-color: #4f46e5;
  }

  .tab-button.active span {
    background-color: #eef2ff;
    color: #4f46e5;
  }
</style>

<script>
  // Tab switching
  function switchTab(tabName) {
    // Hide all tab contents
    document.querySelectorAll('.tab-content').forEach(content => {
      content.classList.add('hidden');
    });

    // Remove active class from all tabs
    document.querySelectorAll('.tab-button').forEach(button => {
      button.classList.remove('active');
    });

    // Show selected tab content
    document.getElementById('content-' + tabName).classList.remove('hidden');

    // Add active class to selected tab
    document.getElementById('tab-' + tabName).classList.add('active');
  }

  // Toggle group collapse
  function toggleGroup(header) {
    const group = header.parentElement;
    const content = group.querySelector('.group-content');
    const chevron = header.querySelector('.group-chevron');

    content.classList.toggle('hidden');
    chevron.classList.toggle('rotate-90');
  }

  // Expand all groups on page load
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.territory-group').forEach(group => {
      const content = group.querySelector('.group-content');
      const chevron = group.querySelector('.group-chevron');
      if (content && chevron) {
        content.classList.remove('hidden');
        chevron.classList.add('rotate-90');
      }
    });
  });

  // Filter territories
  function filterTerritories() {
    const searchTerm = document.getElementById('territory-search').value.toLowerCase();
    const groups = document.querySelectorAll('.territory-group');
    let visibleCount = 0;

    groups.forEach(group => {
      const items = group.querySelectorAll('.territory-item');
      let groupHasVisible = false;

      items.forEach(item => {
        const name = item.dataset.name || '';
        const code = item.dataset.code || '';

        if (name.includes(searchTerm) || code.includes(searchTerm)) {
          item.style.display = '';
          groupHasVisible = true;
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      group.style.display = groupHasVisible ? '' : 'none';
    });

    // Show/hide no results message
    const noResults = document.getElementById('no-results');
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  // Filter exceptions
  function filterExceptions() {
    const searchTerm = document.getElementById('exception-search').value.toLowerCase();
    const items = document.querySelectorAll('.exception-item');
    let visibleCount = 0;

    items.forEach(item => {
      const territory = item.dataset.territory || '';
      const media = item.dataset.media || '';

      if (territory.includes(searchTerm) || media.includes(searchTerm)) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Show/hide no results message
    const noResults = document.getElementById('no-exception-results');
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }
</script>
