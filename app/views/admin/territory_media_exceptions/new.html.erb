<div class="bg-white shadow">
  <div class="px-4 sm:px-6 lg:max-w-7xl lg:mx-auto lg:px-8">
    <div class="py-6 md:flex md:items-center md:justify-between">
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
          Add Territory Media Exception
        </h1>
        <p class="mt-1 text-sm text-gray-500">
          Create an exception to override standard formula calculations for a specific territory and media type combination
        </p>
      </div>
      <div class="mt-4 flex md:mt-0 md:ml-4">
        <%= link_to admin_territories_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Territories
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-8 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <%= form_with model: @exception, url: admin_territory_exceptions_path, local: true, class: "space-y-6" do |f| %>
        <% if @exception.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
            <h3 class="font-semibold mb-2">Please correct the following errors:</h3>
            <ul class="list-disc list-inside text-sm">
              <% @exception.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Territory Name -->
          <div>
            <%= f.label :territory_name, "Territory", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :territory_name,
                options_for_select(TerritoryMediaException.territory_names.map { |name| [name, name] }, @exception.territory_name),
                { prompt: "Select a territory" },
                { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
          </div>

          <!-- Media Type -->
          <div>
            <%= f.label :media_type, "Media Type", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :media_type,
                options_for_select(TerritoryMediaException::MEDIA_TYPES.map { |value| [TerritoryMediaException::MEDIA_TYPE_LABELS[value], value] }, @exception.media_type),
                { prompt: "Select a media type" },
                { class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
          </div>
        </div>

        <!-- Percentage -->
        <div>
          <%= f.label :percentage, "Override Percentage", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="relative">
            <%= f.number_field :percentage,
                class: "w-full border border-gray-300 rounded-md px-3 py-2 pr-8 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                placeholder: "Enter percentage (e.g., 1200)",
                step: 5, min: 0, max: 5000 %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
              <span class="text-gray-500 text-sm">%</span>
            </div>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            This percentage will override the standard formula calculation for this territory + media type combination.
          </p>
        </div>

        <!-- Description -->
        <div>
          <%= f.label :description, "Description (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :description,
              class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
              rows: 3,
              placeholder: "Optional description or notes about this exception" %>
        </div>

        <!-- Examples -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <h4 class="text-sm font-medium text-blue-900 mb-2">Examples:</h4>
          <ul class="text-sm text-blue-800 space-y-1">
            <li>• Worldwide + All Moving Media = 1000%</li>
            <li>• Worldwide + Internet Only = 600%</li>
            <li>• USA & Canada + All Moving Media = 500%</li>
          </ul>
          <p class="mt-2 text-xs text-blue-700">
            Note: "All Media" exceptions are not needed as territories already cover all media types by default.
          </p>
        </div>

        <!-- Actions -->
        <div class="flex justify-end space-x-3 pt-6 border-t border-gray-200">
          <%= link_to admin_territories_path, class: "inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" do %>
            Cancel
          <% end %>
          <%= f.submit "Create Exception", class: "inline-flex justify-center items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>