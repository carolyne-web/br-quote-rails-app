<div>
  <div class="px-4 sm:px-6 lg:max-w-7xl lg:mx-auto lg:px-8">
    <div class="pt-6 md:flex md:items-center md:justify-between">
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
          Your Quotations
        </h1>
      </div>
      <div class="mt-4 flex space-x-3 md:mt-0 md:ml-4">
        <%= link_to new_support_request_path, class: "bg-gray-50 inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-60 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
          <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          Contact Support
        <% end %>
        <%= link_to "New Quotation", new_quotation_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    </div>
  </div>
</div>

<div class="mt-8">
  <% if @quotations.any? %>
    <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg" style="
    width: 90vw;
    margin: 0 auto;">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Campaign Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quote Number</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @quotations.each do |quotation| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap"><%= quotation.project_name %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= quotation.project_number %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= quotation.created_at.strftime("%B %d, %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex justify-between">
                <%= link_to "View", quotation, class: "text-indigo-600 hover:text-indigo-900 mr-4" %>
                <%= link_to "Delete", quotation, method: :delete, data: { confirm: "Are you sure you want to delete this quotation?" }, class: "text-red-600 hover:text-red-900 hidden" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 p-6 flex items-center justify-between" style="
    width: 90vw; margin: 0 auto;">
      <div class="text-sm text-gray-700">
        Showing <%= @quotations.offset_value + 1 %> to <%= [@quotations.offset_value + @quotations.limit_value, @quotations.total_count].min %> of <%= @quotations.total_count %> quotations
      </div>
      <%= paginate @quotations, class: 'flex justify-end' %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500">No quotations yet.</p>
      <%= link_to "Create your first quotation", new_quotation_path, class: "mt-4 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
