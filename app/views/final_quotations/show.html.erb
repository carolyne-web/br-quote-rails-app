<% content_for :title, "Final Quotation" %>

<div class="max-w-7xl mx-auto p-6 bg-white">
  <!-- Header Section -->
  <div class="border-b pb-6 mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @final_quotation.project_name %></h1>
        <p class="text-lg text-gray-600">Project #<%= @final_quotation.project_number %></p>
        <div class="flex gap-4 mt-2">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
            <%= @final_quotation.product_type&.humanize %>
          </span>
          <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
            <%= @final_quotation.commercial_type %>
          </span>
          <% if @final_quotation.is_guaranteed %>
            <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">
              Guaranteed (25% Discount Applied)
            </span>
          <% end %>
        </div>
      </div>
      <div class="flex gap-2">
        <%= link_to "PDF", final_quotation_path(@final_quotation, format: :pdf),
            class: "btn btn-secondary", target: "_blank" %>
        <%= link_to "Duplicate", duplicate_final_quotation_path(@final_quotation),
            method: :post, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>

  <!-- Two Column Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Left Column (Detailed Inputs) -->
    <div class="lg:col-span-2 space-y-8">

      <!-- 1. Campaign Info -->
      <div class="bg-white border rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Campaign Info</h2>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="font-medium text-gray-700">Campaign Name:</span>
            <span class="text-gray-900"><%= @final_quotation.quotation.campaign_name %></span>
          </div>
          <div class="flex justify-between">
            <span class="font-medium text-gray-700">Product Type:</span>
            <span class="text-gray-900"><%= @final_quotation.product_type&.humanize %></span>
          </div>
          <div class="flex justify-between">
            <span class="font-medium text-gray-700">Type of Commercial:</span>
            <span class="text-gray-900"><%= @final_quotation.commercial_type %></span>
          </div>
        </div>
      </div>

      <!-- 2. Talent Summary Table -->
      <div class="bg-white border rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Talent Summary</h2>

        <% if @final_quotation.final_quotation_groups.any? && @final_quotation.final_quotation_groups.flat_map(&:final_quotation_talent_lines).any? %>
          <div class="overflow-x-auto">
            <table class="w-full border border-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-sm font-medium text-gray-700 border-b">Category</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-gray-700 border-b">Description</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Talent</th>
                  <th class="px-4 py-3 text-right text-sm font-medium text-gray-700 border-b">Rate</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Shoot Days</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Rehearsal</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Down Days</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Travel Days</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Overtime</th>
                  <th class="px-4 py-3 text-center text-sm font-medium text-gray-700 border-b">Night</th>
                  <th class="px-4 py-3 text-right text-sm font-medium text-gray-700 border-b">Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% # Show talent lines from first group only to avoid duplicates in Talent Summary %>
                <% first_group = @final_quotation.final_quotation_groups.ordered.first %>
                <% if first_group %>
                  <% first_group.final_quotation_talent_lines.each do |talent_line| %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-3 text-sm font-medium text-gray-900 border-b">
                        <%= talent_line.category_type %>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-700 border-b">
                        <%= talent_line.description.present? ? talent_line.description : '-' %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.talent_count %>
                      </td>
                      <td class="px-4 py-3 text-sm text-right text-gray-700 border-b">
                        R<%= number_with_delimiter(talent_line.adjusted_rate) %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.shoot_days %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.rehearsal_days %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.down_days %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.travel_days %>
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <%= talent_line.overtime_hours %> hrs
                      </td>
                      <td class="px-4 py-3 text-sm text-center text-gray-700 border-b">
                        <% if talent_line.has_night_premium %>
                          <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                            Yes
                          </span>
                        <% else %>
                          <span class="text-gray-400">No</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3 text-sm text-right font-semibold text-green-600 border-b">
                        R<%= number_with_delimiter(talent_line.total_talent_fee) %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
              <tfoot class="bg-gray-50">
                <tr>
                  <td colspan="10" class="px-4 py-3 text-sm font-semibold text-gray-900 text-right border-t">
                    Talent Summary Total:
                  </td>
                  <td class="px-4 py-3 text-sm font-bold text-green-600 text-right border-t">
                    <% # Sum from first group only to match displayed lines %>
                    <% first_group_total = @final_quotation.final_quotation_groups.ordered.first&.final_quotation_talent_lines&.sum(&:total_talent_fee) || 0 %>
                    R<%= number_with_delimiter(first_group_total) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-500">
            <p>No talent data available</p>
          </div>
        <% end %>
      </div>

      <!-- 3. Usage Summary (repeated per usage group) -->
      <div class="bg-white border rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Usage Summary</h2>
        <% @final_quotation.final_quotation_groups.ordered.each_with_index do |group, index| %>
          <div class="bg-blue-50 rounded-lg p-4 mb-4">
            <h3 class="font-semibold text-gray-800 mb-3">Group <%= group.group_number %> - <%= group.duration&.humanize %></h3>

            <!-- Territories and Media -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <h4 class="font-medium text-gray-700 mb-2">Territories:</h4>
                <div class="space-y-1">
                  <% if group.selected_territories.is_a?(Array) %>
                    <% group.selected_territories.each do |territory| %>
                      <div class="flex justify-between text-sm">
                        <span><%= territory['name'] %></span>
                        <span class="font-medium"><%= territory['percentage'] %>%</span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <div>
                <h4 class="font-medium text-gray-700 mb-2">Media Types:</h4>
                <div class="space-y-1">
                  <% if group.selected_media_types.is_a?(Array) %>
                    <% group.selected_media_types.each do |media| %>
                      <span class="inline-block bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs mr-1 mb-1">
                        <%= media.humanize %>
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Usage Breakdown per Talent -->
            <div class="overflow-x-auto">
              <table class="w-full text-sm border border-gray-200">
                <thead class="bg-gray-100">
                  <tr>
                    <th class="px-3 py-2 text-left border">Talent</th>
                    <th class="px-3 py-2 text-right border">Day Fee</th>
                    <th class="px-3 py-2 text-right border">Unit</th>
                    <th class="px-3 py-2 text-center border">Exclusivity</th>
                    <th class="px-3 py-2 text-right border">Buyout %</th>
                    <th class="px-3 py-2 text-right border">Per Talent Cost</th>
                    <th class="px-3 py-2 text-right border">Total (R)</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.final_quotation_talent_lines.each do |line| %>
                    <tr class="border-b">
                      <td class="px-3 py-2 border"><%= line.description %></td>
                      <td class="px-3 py-2 text-right border">R<%= number_with_delimiter(line.adjusted_rate) %></td>
                      <td class="px-3 py-2 text-right border"><%= line.talent_count %></td>
                      <td class="px-3 py-2 text-center border">
                        <%= @final_quotation.exclusivity_type ? 'Y' : 'N' %>
                      </td>
                      <td class="px-3 py-2 text-right border">
                        <%
                          # Calculate actual buyout percentage from stored values
                          # This matches exactly what was calculated in the new quotation page
                          if line.base_fee > 0
                            actual_buyout_percentage = (line.usage_fee.to_f / line.base_fee.to_f) * 100
                          else
                            actual_buyout_percentage = 0
                          end
                        %>
                        <%= actual_buyout_percentage.floor %>%
                      </td>
                      <td class="px-3 py-2 text-right border">R<%= number_with_delimiter(line.usage_fee) %></td>
                      <td class="px-3 py-2 text-right border font-medium">R<%= number_with_delimiter(line.total_line_cost) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <% if @final_quotation.is_guaranteed %>
              <div class="mt-3 p-3 bg-purple-50 border border-purple-200 rounded">
                <div class="flex justify-between text-sm">
                  <span class="text-purple-700 font-medium">Guarantee Applied:</span>
                  <span class="text-purple-700 font-medium">25% Discount</span>
                </div>
              </div>
            <% end %>

            <div class="mt-4 pt-4 border-t border-gray-300">
              <div class="flex justify-between text-lg font-semibold">
                <span>Usage Subtotal:</span>
                <span class="text-blue-600">R<%= number_with_delimiter(group.group_usage_fee) %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

    </div>


  <!-- Footer Actions -->
  <div class="mt-8 flex justify-center gap-4">
    <%= link_to "← Back to Quotations", quotations_path, class: "btn btn-secondary" %>
  </div>
</div>